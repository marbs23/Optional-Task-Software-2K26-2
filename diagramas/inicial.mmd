classDiagram
    class Database {
        +str path
        +connect() Connection
        +initialize() None
    }
    class OrderService {
        +Database database
        +save(customer_id, address, city, postal_code, shipping, items, order_id) dict
        +quote(data) dict
        +get(order_id) dict
        +list() list
        +confirm(order_id) dict
        +cancel(order_id) dict
        +delete(order_id) None
        +notifications(order_id) list
    }
    class OrderInput {
        +int customer_id
        +str address
        +str city
        +str postal_code
        +str shipping
        +list~ItemInput~ items
        +unique_products() OrderInput
    }
    class ItemInput {
        +int product_id
        +int quantity
    }
    class ProductInput {
        +str name
        +int price_cents
        +int stock
    }
    class CustomerInput {
        +str name
        +EmailStr email
        +str category
    }
    class HTTPException
    OrderService --> Database : usa
    OrderService ..> OrderInput : recibe
    OrderService ..> HTTPException : lanza
    OrderInput "1" *-- "1..*" ItemInput : items
